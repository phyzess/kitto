{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "strict": true,
    "noImplicitAny": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "integration/**/*.ts", "types/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/comment-ratchet.ts", "scripts/comment-ratchet/**", "scripts/check-comments.ts", "tests/comment-ratchet.test.ts"]
}
