{
  "name": "@phyzess/kitto",
  "version": "0.4.0",
  "private": true,
  "description": "Portable personal configuration for Pi, Codex and DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phyzess/kitto.git"
  },
  "bin": {
    "kitto": "bin/kitto.mjs"
  },
  "files": [
    "bin/*.mjs",
    "lib/*.mjs",
    "lib/hosts/*.mjs",
    "integration/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:test-wiring": "node scripts/check-test-wiring.ts",
    "lint:invariants": "node scripts/check-invariants.ts",
    "typecheck": "tsc -p tsconfig.json",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint:ox": "oxlint",
    "lint:comments": "node scripts/check-comments.ts",
    "lint:versions": "node scripts/check-version-literals.ts",
    "test": "vp test run",
    "build": "vp pack",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.43.0",
    "@types/node": "26.6.11",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite-plus": "1.8.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0",
    "node": ">=26.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./integration/cordis.patch.yml"
    }
  },
  "pi": {
    "extensions": [
      "./integration/pi.mjs"
    ],
    "skills": [
      "./integration/skills"
    ]
  }
}
