{
  "name": "@phyzess/kitto",
  "private": true,
  "version": "0.4.0",
  "description": "Portable personal configuration for Pi, Codex and DeepSeek Harness",
  "type": "module",
  "bin": { "kitto": "bin/kitto.mjs" },
  "engines": { "node": ">=26.0.0", "dsh": ">=0.2.2-rc.2 <0.3.0" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/phyzess/kitto.git" },
  "files": ["bin/*.mjs", "lib/*.mjs", "lib/hosts/*.mjs", "integration/", "CHANGELOG.md"],
  "dependencies": { "@clack/prompts": "1.9.0" },
  "devDependencies": { "@ast-grep/cli": "0.43.0", "@types/node": "26.6.11", "oxlint": "1.95.0", "typescript": "7.0.2", "vite-plus": "1.8.0", "yaml": "2.9.1" },
  "scripts": {
    "check:test-wiring": "node scripts/check-test-wiring.ts",
    "lint:invariants": "node scripts/check-invariants.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint:ox": "oxlint",
    "lint:comments": "node scripts/check-comments.ts",
    "lint:versions": "node scripts/check-version-literals.ts",
    "test": "vp test run",
    "build": "vp pack",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.ts"
  },
  "pi": { "extensions": ["./integration/pi.mjs"], "skills": ["./integration/skills"] },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./integration/cordis.patch.yml" } }
}
