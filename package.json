{
  "name": "@phyzess/kitto",
  "version": "0.4.0",
  "description": "Portable personal configuration for Pi, Codex and DeepSeek Harness",
  "type": "module",
  "bin": { "kitto": "bin/kitto.mjs" },
  "engines": { "node": ">=22.0.0", "dsh": ">=0.2.2-rc.2 <0.3.0" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/phyzess/kitto.git" },
  "files": ["bin/*.mjs", "lib/*.mjs", "integration/", "CHANGELOG.md"],
  "dependencies": { "@clack/prompts": "1.9.0" },
  "devDependencies": { "@ast-grep/cli": "0.43.0", "yaml": "2.9.1" },
  "scripts": {
    "check:test-wiring": "node scripts/check-test-wiring.mjs",
    "lint:invariants": "node scripts/check-invariants.mjs",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:versions": "node scripts/check-version-literals.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "npm test",
    "release": "node scripts/release.mjs"
  },
  "pi": { "extensions": ["./integration/pi.mjs"], "skills": ["./integration/skills"] },
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./integration/cordis.patch.yml" } }
}
