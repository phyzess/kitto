{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.7.3"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "directTools": true,
      "lifecycle": "lazy"
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context=agent", "--project-from-cwd"],
      "directTools": true,
      "lifecycle": "lazy"
    },
    "dap-debug": {
      "command": "dap-mcp-server",
      "args": [],
      "lifecycle": "lazy"
    },
    "ast-grep": {
      "command": "npx",
      "args": ["-y", "ast-grep-mcp@0.0.2"],
      "lifecycle": "lazy"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"],
      "lifecycle": "lazy"
    }
  }
}
